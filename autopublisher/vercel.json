{
  "framework": null,
  "buildCommand": "mkdir -p public && cp index.html public/index.html",
  "outputDirectory": "public",
  "functions": {
    "api/publisher.js": {
      "maxDuration": 60
    },
    "api/cron-summer.js": {
      "maxDuration": 60
    },
    "api/cron-winter.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-summer",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron-winter",
      "schedule": "0 6 * * *"
    }
  ]
}
