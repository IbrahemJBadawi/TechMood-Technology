{
  "framework": null,
  "buildCommand": "mkdir -p public && cp index.html setup.html mark.svg manifest.json sw.js public/",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 180
    }
  },
  "crons": [
    {
      "path": "/api/cron-summer",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron-winter",
      "schedule": "0 6 * * *"
    }
  ]
}